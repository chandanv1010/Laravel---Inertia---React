(98, 0, 0, '', 'Hộp nhựa tròn T001', 'hop-nhua-tron-t001', 'hop-nhua-tron-t001', '', 18, '["1","18","28"]', '/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t001/t001.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/t001\\/z3528753105869-5224cda390fa2293530ff91aa22ede8d.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/t001\\/t001-27.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/t001\\/t001-24.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/t001\\/t001-25.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/t001\\/t001-26.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/t001\\/t001-16.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/t001\\/t001-13.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/t001\\/t001-kt.jpg","title":"","description":""}]', 't001', 0, 10000, 5500, 0, 0, 0, '<p><span style="color:#e74c3c;"><span style="font-size:22px;"><strong>T&ecirc;n sản phẩm: Hộp nhựa tr&ograve;n T001&nbsp;</strong></span></span></p>\r\n\r\n<p><span style="font-size:16px;">* Chức năng sử dụng: Đựng b&aacute;nh kẹo, hạt điều, mứt, &ocirc;mai, thực phẩm kh&ocirc; kh&aacute;c, hương trầm, hương nụ, tr&agrave; hoa, tr&agrave; kh&ocirc;...vv</span></p>\r\n\r\n<p><span style="font-size:16px;">* M&agrave;u sắc: Trong suốt</span></p>\r\n\r\n<p><span style="font-size:16px;">* Chất liệu: Nhựa GPPS nguy&ecirc;n sinh</span></p>\r\n\r\n<p><span style="font-size:16px;">* K&iacute;ch thước: Phi 105mmx cao 43mm</span></p>\r\n\r\n<p><span style="font-size:16px;">* Trọng lượng : 52<strong>g&nbsp;</strong></span></p>\r\n\r\n<p><span style="font-size:16px;">* Tổng Hộp + Hạt = 2<strong>00g</strong></span></p>\r\n\r\n<p><br />\r\n* <span style="font-size:18px;"><strong><span style="color:#e74c3c;">ĐỂ NHẬN GI&Aacute; TỐT NHẤT</span></strong>: Q&uacute;y kh&aacute;ch vui l&ograve;ng&nbsp;<strong><em>Li&ecirc;n hệ ngay hotline/ zalo:&nbsp;&nbsp;090 456 9683 --- 0983 81 2311.</em></strong></span></p>\r\n', '<p><span style="color:#e74c3c;"><span style="font-size:22px;"><strong>T&ecirc;n sản phẩm: Hộp nhựa tr&ograve;n T001</strong></span></span></p>\r\n\r\n<p><span style="font-size:16px;">* Chức năng sử dụng: Đựng b&aacute;nh kẹo, hạt điều, mứt, &ocirc;mai, thực phẩm kh&ocirc; kh&aacute;c, hương trầm, hương nụ, tr&agrave; hoa, tr&agrave; kh&ocirc;...vv</span></p>\r\n\r\n<p><span style="font-size:16px;">* M&agrave;u sắc: Trong suốt</span></p>\r\n\r\n<p><span style="font-size:16px;">* Chất liệu: Nhựa GPPS nguy&ecirc;n sinh</span></p>\r\n\r\n<p><span style="font-size:16px;">* K&iacute;ch thước: Phi 105mmx cao 43mm</span></p>\r\n\r\n<p><span style="font-size:16px;">* Trọng lượng : 52<strong>g&nbsp;</strong></span></p>\r\n\r\n<p><span style="font-size:16px;">* Tổng Hộp + Hạt = 2<strong>00g</strong></span></p>\r\n\r\n<p><br />\r\n* <span style="font-size:18px;"><strong><span style="color:#e74c3c;">ĐỂ NHẬN GI&Aacute; TỐT NHẤT</span></strong>: Q&uacute;y kh&aacute;ch vui l&ograve;ng&nbsp;<strong><em>Li&ecirc;n hệ ngay hotline/ zalo:&nbsp;&nbsp;090 456 9683 --- 0983 81 2311.</em></strong></span></p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t001/t001.jpg" style="width: 800px; height: 800px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t001/t001-27.jpg" style="width: 800px; height: 667px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t001/t001-24.jpg" style="width: 800px; height: 667px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t001/t001-25.jpg" style="width: 800px; height: 667px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t001/t001-26.jpg" style="width: 800px; height: 667px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t001/t001-16.jpg" style="width: 800px; height: 800px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t001/t001-13.jpg" style="width: 800px; height: 800px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t001/t001-kt.jpg" style="width: 800px; height: 800px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>', '', 15, 1243, 1, -1, -1, -1, 0, 1, 0, 'hộp nhựa tròn', 'hộp nhựa tròn', 'hộp nhựa tròn', 7, 7, '2022-07-15 16:26:58', '2025-04-01 11:54:53'),
(99, 0, 0, '', 'Bánh xe con lăn nhựa 2 vòng bi', 'banh-xe-con-lan-nhua-2-vong-bi', 'banh-xe-con-lan-nhua-2-vong-bi', '', 1, '["1","2","31"]', '/uploads/images/san-pham-nhua/nhua-cong-nghiep/1.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/7.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/4.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/5.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/6.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/11.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/8.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/9.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/10.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/15.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/13.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/14.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/12.jpg","title":"","description":""}]', 'K6001', 0, 500, 0, 0, 0, 0, '<p><iframe allowfullscreen="" frameborder="0" height="360" src="//www.youtube.com/embed/wuvp2uMMu5s" width="640"></iframe></p>\r\n', '<p><span style="color:#c0392b;"><span style="font-size:22px;"><strong>B&Aacute;NH XE CON LĂN NHỰA 2 V&Ograve;NG BI</strong></span></span></p>\r\n\r\n<p><span style="font-size:16px;">***D&agrave;nh cho AE cửa l&ugrave;a, cửa cuốn, cửa k&eacute;o y&ecirc;u th&iacute;ch sản phẩ