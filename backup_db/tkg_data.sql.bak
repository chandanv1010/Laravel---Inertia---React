 zalo:&nbsp;&nbsp;090 456 9683 --- 0983 81 2311.</em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:20px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/ed50/ed50.jpg" style="width: 800px; height: 800px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:20px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/ed50/ed50a.jpg" style="width: 800px; height: 800px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:20px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/ed50/ed50-5.jpg" style="width: 800px; height: 667px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:20px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/ed50/ed50-3.jpg" style="width: 800px; height: 800px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:20px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/ed50/ed50-2.jpg" style="width: 800px; height: 800px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:20px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/ed50/ed50-1.jpg" style="width: 800px; height: 897px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:20px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/ed50/ed50-kt.jpg" style="width: 800px; height: 800px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>', '', 21, 1998, 1, -1, -1, -1, 0, 1, 0, 'Hộp nhựa trong suốt hình Elip 180g', 'Hộp nhựa trong 