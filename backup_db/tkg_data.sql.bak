(6, 0, 'GIỚI THIỆU CÔNG TY', 'gioi-thieu-cong-ty', 'gioi-thieu-cong-ty', 1, '["1"]', '/uploads/images/may-moc-thiet-bi/196a54d5dab03aee63a1.jpg', '""', '<p><span style="font-size:22px;"><strong><span style="line-height:115%"><span style="font-family:Calibri,sans-serif"><span style="line-height:115%"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;">C&Ocirc;NG TY CPSX V&Agrave; THƯƠNG MẠI TKG VIỆT NAM</span></span></span></span></strong></span></p>', '<p style="margin:0in 0in 10pt"><span style="font-size:20px;"><span style="line-height:115%"><span style="font-family:Calibri,serif"><span style="line-height:115%"><span style="font-family:&quot;Times New Roman&quot;,&quot;serif&quot;">C&ocirc;ng ty cổ phần sản xuất v&agrave; thương mại TKG Việt Nam chuy&ecirc;n sản xuất, kinh doanh đồ nhựa, gia c&ocirc;ng &eacute;p nhựa, thiết kế, chế tạo khu&ocirc;n mẫu theo y&ecirc;u cầu.</span></span></span></span></span></p>\r\n\r\n<p style="margin:0in 0in 10pt"><span style="font-size:20px;"><span style="line-height:115%"><span style="font-family:Calibri,serif"><span style="line-height:115%"><span style="font-family:&quot;Times New Roman&quot;,&quot;serif&quot;">Trong hoạt động sản xuất kinh doanh TKG Việt Nam lu&ocirc;n giữ chữ t&iacute;n l&agrave; h&agrave;ng đầu, kh&ocirc;ng ngừng t&igrave;m t&ograve;i, s&aacute;ng tạo những sản phẩm đ&aacute;p ứng nhu cầu cao của thị trường đồ nhựa. Trong quan hệ kh&aacute;ch h&agrave;ng TKG Việt Nam lu&ocirc;n lu&ocirc;n đặt quyền lợi v&agrave; c&ugrave;ng kiến tạo chiến lược kinh doanh hiệu quả với kh&aacute;ch h&agrave;ng.</span></span></span></span></span></p>\r\n\r\n<p style="margin:0in 0in 10pt"><span style="font-size:20px;"><span style="line-height:115%"><span style="font-family:Calibri,serif"><span style="line-height:115%"><span style="font-family:&quot;Times New Roman&quot;,&quot;serif&quot;">Sản phẩm đồ nhựa, khu&ocirc;n mẫu nhựa, l&agrave; những tuyệt phẩm kết tinh T&acirc;m- Tr&iacute;- T&igrave;nh của tập thể TKG Việt Nam. Sản phẩm nhựa được &eacute;p, đ&uacute;c từ nhựa nguy&ecirc;n sinh, kh&ocirc;ng m&ugrave;i, kh&ocirc;ng độc hại, bền đẹp với thời gian, th&acirc;n thiện với m&ocirc;i trường.</span></span></span></span></span></p>\r\n\r\n<p style="margin:0in 0in 10pt"><span style="font-size:20px;"><span style="line-height:115%"><span style="font-family:Calibri,serif"><span style="line-height:115%"><span style="font-family:&quot;Times New Roman&quot;,&quot;serif&quot;">B&ecirc;n cạnh đ&oacute; C&ocirc;ng Ty ch&uacute;ng t&ocirc;i với đội ngũ kỹ sư gi&agrave;u kinh nghiệm, nhiệt huyết, phong c&aacute;ch l&agrave;m việc chuy&ecirc;n nghiệp c&ugrave;ng hệ thống ph&acirc;n xưởng v&agrave; trang thiết bị hiện đại bậc nhất. Ch&uacute;ng t&ocirc;i tin tưởng rằng sẽ phục vụ tốt nhất mọi nhu cầu của Qu&yacute; C&ocirc;ng Ty.</span></span></span></span></span></p>\r\n\r\n<p style="margin:0in 0in 10pt"><span style="font-size:20px;"><span style="line-height:115%"><span style="font-family:Calibri,serif"><span style="line-height:115%"><span style="font-family:&quot;Times New Roman&quot;,&quot;serif&quot;">Trước sự hội nhập v&agrave; mở cửa của đất nước C&ocirc;ng ty TKG Việt Nam đặt&nbsp; ra ba mục ti&ecirc;u trong 5 năm tới.</span></span></span></span></span></p>\r\n\r\n<ol>\r\n	<li style="margin:0in 0in 0.0001pt 0.5in"><span style="font-size:20px;"><span style="line-height:115%"><span style="font-family:Calibri,serif"><span style="line-height:115%"><span style="font-family:&quot;Times New Roman&quot;,&quot;serif&quot;">Đưa sản phẩm đồ nhựa TKG plastics trở th&agrave;nh thương hiệu quốc gia</span></span></span></span></span></li>\r\n	<li style="margin:0in 0in 0.0001pt 0.5in"><span style="font-size:20px;"><span style="line-height:115%"><span style="font-family:Calibri,serif"><span style="line-height:115%"><span style="font-family:&quot;Times New Roman&quot;,&quot;serif&quot;">X&acirc;y dựng một nh&agrave; m&aacute;y đồ nhựa h&agrave;ng đầu Việt Nam</span></span></span></span></span></li>\r\n	<li style="margin:0in 0in 10pt 0.5in"><span style="font-size:20px;"><span style="line-height:115%"><span style="font-family:Calibri,serif"><span style="line-height:115%"><span style="font-family:&quot;Times New Roman&quot;,&quot;serif&quot;">Xuất khẩu đồ nhựa của ch&uacute;ng t&ocirc;i ra nước ngo&agrave;i.</span></span></span></span></span></li>\r\n</ol>\r\n\r\n<p style="margin:0in 0in 10pt"><span style="font-size:20px;"><span style="line-height:115%"><span style="font-family:Calibri,serif"><span style="line-height:115%"><span style="font-family:&quot;Times New Roman&quot;,&quot;serif&quot;">Để đạt được mục ti&ecirc;u đ&oacute; TKG Việt Nam mong muốn được đo&agrave;n kết một l&ograve;ng, hợp t&aacute;c chặt chẽ với tất cả c&aacute;c th&agrave;nh vi&ecirc;n đội ngũ TKG Việt Nam, với đối t&aacute;c của TKG.</span></span></span></span></span></p>\r\n\r\n<p style="margin:0in 0in 10pt"><span style="font-size:20px;"><span style="line-height:115%"><span style="font-family:Calibri,serif"><span style="line-height:115%"><span style="font-family:&quot;Times New Roman&quot;,&quot;serif&quot;">TKG plastics Việt Nam xin ch&acirc;n th&agrave;nh cảm ơn sự hợp t&aacute;c của Qu&yacute; C&ocirc;ng Ty!</span></span></span></span></span></p>', 0, 1378, 1, -1, 0, 0, 0, 0, '', '', '', 7, 7, '2018-09-12 16:25:46', '2018-12-22 11:10:03'),
(7, 0, 'tkg việt nam', 'tkg-viet-nam', 'tkg-viet-nam', 3, '["3"]', '/uploads/images/dich-vu/1-38083.jpg', '""', '<p>Li&ecirc;n hệ</p>', '<p style="margin:0in 0in 10pt"><span style="font-size:11pt"><span style="line-height:115%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:12.0pt"><span style="line-height:115%"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;">C&Ocirc;NG TY CỔ PHẦN SẢN XUẤT V&Agrave; THƯƠNG MẠI TKG VIỆT NAM </span></span></span></b></span></span></span></p>\r\n\r\n<p style="margin:0in 0in 10pt">Trụ sở ch&iacute;nh: Số 30E, Ng&otilde; 87, Tam Trinh, Mai Động, Ho&agrave;ng Mai, H&agrave; Nội.</p>\r\n\r\n<p style="margin:0in 0in 10pt">Xưởng sản xuất :Số&nbsp;40- Tổ 25, Y&ecirc;n Sở, Ho&agrave;ng Mai, H&agrave; Nội.</p>\r\n\r\n<p style="margin:0in 0in 10pt">Điện thoại: 0983 81 2311-&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;090456 9683</p>', 0, 161, 1, 1, 0, 1, 1, 0, '', '', '', 7, 7, '2018-09-13 10:52:46', '2018-09-19 12:40:55'),
(8, 0, 'THÔNG BÁO TUYỂN DỤNG', 'thong-bao-tuyen-dung', 'thong-bao-tuyen-dung', 2, '["2"]', '/uploads/images/dich-vu/services-5.png', '""', '<p>&nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<strong style="font-size: 16px;">TUYỂN DỤNG</strong></p>', '<p><img alt="" src="/uploads/images/anh-chinh/tuyen-dung-2021.jpg" style="width: 1000px; height: 1306px;" /></p>', 0, 1501, 1, -1, 0, 0, 0, 0, 'Tuyển dụng', 'tuyển dụng', '1-KỸ THUẬT VIÊN LẬP TRÌNH VẬN HÀNH MÁY PHAY CNC\r\n2-KỸ THUẬT VIÊN NGUỘI KHUÔN MẪU NHỰA\r\n3-KỸ THUẬT ÉP NHỰA', 7, 7, '2018-09-13 11:01:16', '2021-04-16 09:17:55'),
