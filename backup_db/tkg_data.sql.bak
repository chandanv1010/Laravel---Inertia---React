"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/tk7.jpg","title":"","description":""}]', 'TV03', 0, 5000, 0, 0, 0, 0, '<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">TH&Ugrave;NG NHỰA H&Igrave;NH VU&Ocirc;NG&nbsp;3L </span></span></span></b></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif"><iframe allowfullscreen="" frameborder="0" height="360" src="//www.youtube.com/embed/70QuQTsWozQ" width="640"></iframe></span></span></span></b></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif"><iframe allowfullscreen="" frameborder="0" height="360" src="//www.youtube.com/embed/sgVl8doxo0c" width="640"></iframe></span></span></span></b></span></span></span></p>\r\n', '<p style="margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">1 &ndash; TH&Ocirc;NG TIN CHI TIẾT TH&Ugrave;NG NHỰA H&Igrave;NH VU&Ocirc;NG 3L</span></span></span></b></span></span></span></p>\r\n\r\n<ul>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">Dung t&iacute;ch: 3 L&iacute;t </span></span></span></span></span></span></li>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">K&iacute;ch thước: Nắp 16 x đ&aacute;y 14 x cao 20cm</span></span></span></span></span></span></li>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">Chất liệu: Nhựa PP nguy&ecirc;n sinh cao cấp</span></span></span></span></span></span></li>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">Quy c&aacute;ch: 30 chiếc/ kiện.</span></span></span></span></span></span></li>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">M&agrave;u sắc: C&oacute; sẵn m&agrave;u Trắng- Đen- Trong suốt</span></span></span></span></span></span></li>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">M&agrave;u sắc kh&aacute;c sản xuất theo y&ecirc;u cầu khi đạt số lượng &gt; 1.000 chiếc</span></span></span></span></span></span></li>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">Nh&agrave; m&aacute;y sản xuất: CCN Li&ecirc;n Phương- Thường T&iacute;n- H&agrave; Nội</span></span></span></span></span></span></li>\r\n	<li style="margin:0cm 0cm 8pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">Call/zalo: 090 456 9683</span></span></span></span></span></span></li>\r\n</ul>\r\n\r\n<p style="margin:0cm 0cm 8pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 8pt 36pt"><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/t27.jpg" style="width: 800px; height: 1130px;" /></p>\r\n\r\n<p style="margin:0cm 0cm 8pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 8pt 36pt"><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/t28.jpg" style="width: 800px; height: 1130px;" /></p>\r\n\r\n<p style="margin:0cm 0cm 8pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 8pt 36pt"><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/thung-nhua-hinh-vuong-3l-800px.jpg" style="width: 800px; height: 800px;" /></p>\r\n\r\n<p style="margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">2 - ỨNG DỤNG CỦA TH&Ugrave;NG NHỰA H&Igrave;NH VU&Ocirc;NG 3L </span></span></span></b></span></span></span></p>\r\n\r\n<ul>\r\n	<li style="margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif">Th&ugrave;ng nhựa h&igrave;nh vu&ocirc;ng được sản xuất bằng nhựa PP nguy&ecirc;n sinh cao cấp<b> </b>với t&iacute;nh chất dẻo dai, độ bền cơ học cao </span></span><span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="color:#231f20">chịu va đập tốt, chống trầy xước bề mặt, chống biến dạng cao, an to&agrave;n vệ sinh thực phẩm n&ecirc;n được được sử dụng rất phong ph&uacute; cho c&aacute;c ng&agrave;nh C&ocirc;ng nghi&ecirc;p, N&ocirc;ng Nghiệp, Thực Phẩm&hellip;</span></span></span></span></span></span></span></li>\r\n</ul>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<ul>\r\n	<li style="margin-top:0cm; margin-right:0cm; margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif">Trong C&ocirc;ng Nghi&ecirc;p</span></span></b><span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif"> như </span></span><span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="color:#231f20">đựng Sơn Nước, Sơn dầu, nước giặt, bột giặt, bột tẩy javen &hellip;vv</span></span></span></span></span></span></span></li>\r\n</ul>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 0.0001pt 36pt">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/t21.jpg" style="width: 300px; height: 300px;" />&nbsp; &nbsp;<img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/t18.jpg" style="width: 300px; height: 300px;" /></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif">&nbsp; <span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="color:#231f20">&nbsp;&nbsp;&nbsp;</span></span></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="color:#231f20">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<i>Th&ugrave;ng d&ugrave;ng để đựng sản phẩm C&ocirc;ng Nghiệp</i></span></span></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<ul>\r\n	<li style="margin-top:0cm; margin-right:0cm; margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 8pt 36pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif">Trong Thực Phẩm</span></span></b><span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif"> như đựng kem, đựng bột ngũ cốc, hạt ngũ cốc &hellip;vv. </span></span><span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="color:#231f20">PP thực phẩm rất an to&agrave;n cho sức khỏe người ti&ecirc;u d&ugrave;ng.</span></span></span></span></span></span></span></li>\r\n</ul>\r\n\r\n<p style="margin-top:0cm; margin-right:0cm; margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 8pt 36pt"><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/t24-800px.jpg" style="width: 800px; height: 800px;" /></p>\r\n\r\n<p style="margin-top:0cm; margin-right:0cm; margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 8pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin-top:0cm; margin-right:0cm; margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 8pt 36pt"><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/t23-800px.jpg" style="width: 800px; height: 800px;" /></p>\r\n\r\n<p style="margin-top:0cm; margin-right:0cm; margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 8pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<i><span style="font-size:14.0pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="color:#231f20">Th&ugrave;ng d&ugrave;ng để đựng thực phẩm</span></span></span></i></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<ul>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">Trong n&ocirc;ng nghiệp</span></span></span></b><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif"> như đựng c&aacute;c loại thức ăn chăn nu&ocirc;i cho gia s&uacute;c, gia cầm, cho c&aacute;, c&aacute;c loại ph&acirc;n b&oacute;n&hellip;vv</span></span></span></span></span></span></li>\r\n</ul>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 8pt 36pt">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;&nbsp; &nbsp;&nbsp;<img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/t26.jpg" style="width: 800px; height: 800px;" /></p>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 8pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 8pt 36pt">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;<img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/t25.jpg" style="width: 800px; height: 800px;" /></p>\r\n\r\n<p style="margin:0cm 0cm 8pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<i><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="color:#231f20">Th&ugrave;ng d&ugrave;ng để đựng sản phẩm thức ăn chăn nu&ocirc;i</span></span></span></span></i></span></span></span></p>\r\n\r\n<p style="margin-top:0cm; margin-right:0cm; margin-bottom:.0001pt; margin-left:18.0pt; text-align:justify; margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<ol start="2">\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">&ndash; NHỮNG ƯU ĐIỂM NỔI BẬT CỦA TH&Ugrave;NG NHỰA H&Igrave;NH VU&Ocirc;NG </span></span></span></b></span></span></span></li>\r\n</ol>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif"><strong>1-&nbsp;</strong> Th&ugrave;ng được l&agrave;m từ nhựa PP nguy&ecirc;n sinh với t&iacute;nh chất dẻo dai, độ bền cơ học cao n&ecirc;n khi vận chuyển chịu được va đập lớn. Nắp th&ugrave;ng được thiết kế kiểu ni&ecirc;m phong k&iacute;n gi&uacute;p sản phẩm chất lỏng được bảo quản k&iacute;n<span style="background:white"><span style="color:#231f20"> rơi từ tr&ecirc;n cao xuống m&agrave; kh&ocirc;ng hề r&ograve; rỉ 1 giọt nước n&agrave;o</span></span>,<span style="font-size:18px;"><span style="font-family:Times New Roman,Times,serif;"> </span></span></span></span></span><span style="font-size:20px;"><span style="font-family:Times New Roman,Times,serif;">sản phẩm kh&ocirc; được an to&agrave;n tr&aacute;nh ẩm mốc.</span></span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif"><strong>2-&nbsp;</strong>Th&ugrave;ng được thiết kế h&igrave;nh vu&ocirc;ng, kiểu d&aacute;ng mới lạ kh&aacute;c biệt với những th&ugrave;ng &nbsp;h&igrave;nh tr&ograve;n th&ocirc;ng dụng, gi&uacute;p tạo cho sản phẩm c&oacute; một g&oacute;c nh&igrave;n kh&aacute;c biệt, hấp dẫn người mua h&agrave;ng.</span></span></span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt"><strong><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">3-&nbsp;</span></span></span></span></span></span></strong><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">C&oacute; 4 mặt phẳng gi&uacute;p d&aacute;n tem được 4 mặt như nhau tiện lợi khi xếp th&ugrave;ng ở bất kỳ vị tr&iacute; n&agrave;o cũng dễ d&agrave;ng nh&igrave;n thấy thương hiệu sản phẩm.</span></span></span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif"><strong>4</strong>-&nbsp; Th&ugrave;ng c&oacute; h&igrave;nh vu&ocirc;ng cũng l&agrave; một lợi thế khi xếp h&agrave;ng tr&ecirc;n kệ, kho chứa h&agrave;ng, xếp h&agrave;ng l&ecirc;n xe khi vận chuyển, gi&uacute;p tiết kiệm được diện t&iacute;ch, xếp h&agrave;ng dễ d&agrave;ng, nhanh ch&oacute;ng.</span></span></span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-family: &quot;Times New Roman&quot;, serif; font-size: 14pt;"><strong>5-</strong> Phần đ&aacute;y th&ugrave;ng được thiết kế nhỏ đ&uacute;ng bằng khoảng l&otilde;m tr&ecirc;n bề mặt nắp gi&uacute;p c&aacute;c th&ugrave;ng dễ d&agrave;ng xếp chồng l&ecirc;n nhau, xếp cao l&ecirc;n gi&uacute;p tiết kiệm diện t&iacute;ch kho chứa h&agrave;ng, tiết kiệm chi ph&iacute; mặt bằng.</span></p>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 0.0001pt 36pt">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/t17-1.jpg" style="width: 800px; height: 637px;" /></p>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<p align="center" style="margin-left:54.0pt; text-align:center; margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><i><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">Dễ d&agrave;ng xếp chồng l&ecirc;n nhau</span></span></span></i></span></span></span></p>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; </span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif"><strong>6- </strong>M&agrave;u sắc được sản xuất theo m&agrave;u sắc y&ecirc;u cầu thương hiệu của c&ocirc;ng ty cũng l&agrave; lợi thế g&oacute;p mặt v&agrave;o hệ thống nhận diện thương hiệu.</span></span></span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;</p>\r\n\r\n<p style="margin:0cm 0cm 0.0001pt 36pt"><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/t13-mau-sac-1.jpg" style="width: 800px; height: 538px;" /></p>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><i><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; M&agrave;u sắc sản xuất theo y&ecirc;u cầu khi số lượng &gt; 1.000 th&ugrave;ng</span></span></span></i></span></span></span></p>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 0.0001pt 36pt">&nbsp;</p>\r\n\r\n<ul>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">Với số lượng lớn Qu&yacute; Kh&aacute;ch vui l&ograve;ng li&ecirc;n hệ trực tiếp </span></span></span></b></span></span></span></li>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><i>&nbsp;</i><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">Nh&agrave; m&aacute;y sản xuất: CCN Li&ecirc;n Phương- Thường T&iacute;n- H&agrave; Nội</span></span></span></span></span></span></li>\r\n	<li style="margin:0cm 0cm 0.0001pt 36pt"><span style="font-size:11pt"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-size:14.0pt"><span style="line-height:107%"><span style="font-family:&quot;Times New Roman&quot;,serif">Call/zalo: 090 456 9683</span></span></span></span></span></span></li>\r\n</ul>\r\n\r\n<p style="margin-left:54.0pt; margin:0cm 0cm 8pt 36pt">&nbsp;</p>', '', 0, 3953, 1, 1, 1, 1, 0, 1, 0, 'Thùng nhựa hình vuông', 'Thùng nhựa hình vuông', 'Thùng nhựa hình vuông', 7, 7, '2022-07-06 14:53:15', '2025-08-24 05:06:01'),
(83, 5, 0, '', 'Catalogue hũ nhựa nắp nhôm xé', 'catalogue-hu-nhua-nap-nhom-xe', 'catalogue-hu-nhua-nap-nhom-xe', '', 1, '["1","16"]', '/uploads/images/san-pham-nhua/catalogue/ca-ta-hu-xe/anh-bia-web-800-x-800-px-.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/bia-1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/bia-2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/bia-4.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/bia-5.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/1-250ml.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/2-400ml.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/3-500ml.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/4-600ml.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/5-600ml-day.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/6-730ml-day.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/7-750ml.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/8-800ml-day.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/9-800ml.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/10-830ml-day.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/11-930ml-day.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/12-1000ml.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/13-1000ml-day.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/14-1200ml.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hu-nhua-nap-nhom-xe\\/cuoi.jpg","title":"","description":""}]', 'cata03', 0, 0, 0, 0, 0, 0, '<p><span style="color:#2980b9;"><strong><span style="font-size:28px;">HŨ NHỰA NẮP NH&Ocirc;M X&Eacute;&nbsp;</span></strong></span></p>\r\n\r\n<p><span style="color:#e74c3c;"><span style="font-size:36px;"><strong>06 size nay đ&atilde; c&oacute; 14 size- qu&aacute; nhiều lựa chọn</strong></span></span></p>\r\n\r\n<p><iframe allowfullscreen="" frameborder="0" height="360" src="//www.youtube.com/embed/ih8dqK1aEcc" width="640"></iframe></p>\r\n', '<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="color:#2980b9;"><strong><span style="font-size:24px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">BỘ SƯU T&Acirc;P- HŨ V&Agrave; BIỂN XANH</span></span></span></span></strong></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt"><span style="font-size:20px;"><strong><span style="color:#c0392b;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Giữ&nbsp;thực phẩm sạch - Thanh cao s&aacute;ng ngời!</span></span></span></span></strong></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<ul>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Hũ nhựa nắp nh&ocirc;m x&eacute; chưa bao giờ hết HOT!</span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Nh&agrave; sản xuất gi&aacute; tận gốc!</span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">C&oacute; chứng nhận an to&agrave;n vệ sinh thực phẩm c&aacute;c bạn v&ocirc; tư xuất h&agrave;ng v&agrave;o si&ecirc;u thị nh&eacute;!</span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">H&atilde;y nhắn cho m&igrave;nh để nhận gi&aacute; tốt nhất!</span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Call/zalo: 090 456 9683!!!</span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Hũ nhựa nắp nh&ocirc;m x&eacute; cao cấp được chứng nhận an to&agrave;n vệ sinh thực phẩm. Tuyệt đối an to&agrave;n khi đựng thực phẩm.</span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Đa dạng k&iacute;ch thước- qu&aacute; nhiều sự lựa chọn </span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">C&ocirc;ng năng sử dụng đa dạng- d&ugrave;ng đựng c&aacute;c loại thực phẩm!</span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Hũ trong suốt gi&uacute;p khoe sản phẩm b&ecirc;n trong k&iacute;ch th&iacute;ch vị gi&aacute;c người mua h&agrave;ng! </span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Nắp nh&ocirc;m x&eacute; thiết kế ni&ecirc;m phong k&iacute;n- giữ thực phẩm thơm ngon, tươi mới!</span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">C&oacute; nắp nhựa đậy k&iacute;n sau khi giật nắp nh&ocirc;m, kh&aacute;ch h&agrave;ng sẽ rất th&iacute;ch mua h&agrave;ng của bạn để sử dụng lại hũ đựng thực phẩm kh&aacute;c như đường, muối, c&aacute;c loại hạt đỗ&hellip;vv</span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="color:#3498db;"><strong><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Với số lượng lớn Qu&yacute; Kh&aacute;ch vui l&ograve;ng li&ecirc;n hệ trực tiếp</span></span></span></span></strong></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="color:#e74c3c;"><strong><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Nh&agrave; m&aacute;y sản xuất: CCN Li&ecirc;n Phương- Thường T&iacute;n- H&agrave; Nội</span></span></span></span></strong></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="color:#e74c3c;"><strong><span style="font-size:20px;"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;inherit&quot;,serif">Call/zalo: 090 456 9683!</span></span></span></span></strong></span></li>\r\n</ul>\r\n\r\n<p style="margin-bottom:3.75pt; margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<p style="margin-bottom:3.75pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;inherit&quot;,serif"><img alt="" src="/uploads/images/san-pham-nhua/hu-nhua-nap-nhom-xe/bia-1.jpg" style="width: 800px; height: 3000px;" /></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:3.75pt; margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<p style="margin-bottom:3.75pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;inherit&quot;,serif"><img alt="" src="/uploads/images/san-pham-nhua/hu-nhua-nap-nhom-xe/bia-2.jpg" style="width: 800px; height: 1128px;" /></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:3.75pt; margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<p style="margin-bottom:3.75pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;inherit&quot;,serif"><img alt="" src="/uploads/images/san-pham-nhua/hu-nhua-nap-nhom-xe/bia-3.jpg" style="width: 800px; height: 1132px;" /></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:3.75pt; margin:0cm 0cm 8pt">&nbsp;</p>\r\n\r\n<p style="margin-bottom:3.75pt; margin:0cm 0cm 8pt"><span style="font-size:11pt"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:12.0pt"><span style="font-family:&quot;inhe