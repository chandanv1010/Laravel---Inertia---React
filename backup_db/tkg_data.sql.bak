PS nguy&ecirc;n sinh- M&agrave;u: trong suốt</span></span></span></span></li>\r\n	<li style="margin: 0in 0in 10pt;">\r\n	<p style="margin-bottom:.0001pt; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,serif"><span style="font-size:14.0pt"><span style="font-family:&quot;inherit&quot;,&quot;serif&quot;"><span style="color:#1d2129"><strong>H&igrave;nh tr&ograve;n 300g</strong><br />\r\n	K&iacute;ch thước: cao 42 x Mặt nắp 137 mm<br />\r\n	&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Mặt đ&aacute;y 133 mm<br />\r\n	Trọng lượng: 54g</span></span></span></span></span></span></span></p>\r\n	</li>\r\n	<li><span style="color:#c0392b;"><span style="font-size:20px;"><strong>* Gi&aacute; SỈ:&nbsp;<em>Li&ecirc;n hệ ngay hotline/ zalo:&nbsp;&nbsp;090 456 9683 --- 0983 81 2311.</em></strong></span></span></li>\r\n</ul>\r\n\r\n<p><span style="color:#c0392b;"><span style="font-size:20px;"><strong><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/mt300/mt300.jpg" style="width: 800px; height: 800px;" /></em></strong></span></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><span style="font-size:20px;"><strong><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/mt300/mt-300-16.jpg" style="width: 800px; height: 800px;" /></em></strong></span></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><span style="font-size:20px;"><strong><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/mt300/mt-300-17.jpg" style="width: 800px; height: 800px;" /></em></strong></span></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><span style="font-size:20px;"><strong><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/mt300/mt-300-9.jpg" style="width: 800px; height: 800px;" /></em></strong><