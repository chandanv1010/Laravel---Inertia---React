INSERT INTO `comments` (`id`, `fullname`, `phone`, `email`, `module`, `moduleid`, `star`, `message`, `parentid`, `images`, `publish`, `trash`, `userid_created`, `userid_updated`, `created`, `updated`) VALUES
(2, 'Trần Ngọc Anh', '', 'kimcuongdenmtcn@gmail.com', 'products', 21, 5, 'Mình muốn đặt số lượng lớn bên bạn có sẵn hàng không?', 0, '', 1, 0, 0, 0, '2018-09-15 12:39:53', '2018-09-15 12:40:34'),
(3, 'admin', '0983 81 2311 ', 'khuonmautkg@gmail.com', 'products', 21, 0, 'công ty mình sản xuất luôn tục, lúc nào cũng có sẵn hàng bạn nhé, bạn muốn đặt số lượng là bao nhiêu? \n', 2, '[""]', 1, 0, 0, 0, '2018-09-15 12:42:37', '0000-00-00 00:00:00'),
(4, 'admin', '0983 81 2311 ', 'khuonmautkg@gmail.com', 'products', 21, 0, '', 2, '[""]', 1, 0, 0, 0, '2018-09-15 12:46:10', '0000-00-00 00:00:00'),
(5, 'Trần Ngọc Anh', '', 'kimcuongdenmtcn@gmail.com', 'products', 21, 5, 'mình muốn lấy cả 2 loại kích thước như trên. mỗi loại 500 chiếc trước.', 0, '', 1, 0, 0, 0, '2018-09-15 12:46:26', '2018-09-15 12:46:38'),
(6, 'admin', '0983 81 2311 ', 'khuonmautkg@gmail.com', 'products', 21, 0, 'oki! bạn dùng đựng hạt điều, bánh kẹo, hay ô mai... đều được nhé!\nbạn qua số 40. Tổ 25 , Yên Sở, Hoàng Mai, Hà Nội lấy hàng hay mình ships cho bạn!\n', 5, '["",""]', 1, 0, 0, 0, '2018-09-15 12:50:34', '0000-00-00 00:00:00'),
(7, 'Trần Ngọc Anh', '', 'kimcuongdenmtcn@gmail.com', 'products', 21, 5, 'mình qua lấy hàng cũng được bạn ạ! mình cũng tiện qua đó. bạn cho mình số điện thoại khi nào m qua m gọi', 0, '', 1, 0, 0, 0, '2018-09-15 12:52:08', '2018-09-24 11:14:56'),
(8, 'admin', '0983 81 2311 ', 'khuonmautkg@gmail.com', 'products', 21, 0, 'oki bạn! số đt của m: 090456 9683. cảm ơn bạn nhiều nhé!', 7, '[""]', 1, 0, 0, 0, '2018-09-15 12:53:17', '0000-00-00 00:00:00'),
(9, '', '', '', 'products', 3, 5, '', 0, '', 1, 0, 0, 0, '2018-09-19 13:33:03', '2018-09-21 16:29:23'),
