:&nbsp;&nbsp;090 456 9683 --- 0983 81 2311.</em></span></strong></span></p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:18px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t75/t75.jpg" style="width: 800px; height: 800px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:18px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t75/t-75-1.jpg" style="width: 800px; height: 800px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:18px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t75/t-75-3.jpg" style="width: 800px; height: 744px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:18px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t75/t75-5.jpg" style="width: 800px; height: 850px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:18px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t75/bao-bi-hop-nhua.jpg" style="width: 800px; height: 796px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="color:#c0392b;"><strong><span style="font-size:18px;"><em><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/t75/t75-kt.jpg" style="width: 800px; height: 800px;" /></em></span></strong></span></p>\r\n\r\n<p>&nbsp;</p>', '', 12, 465, 1, -1, -1, -1, 0, 1, 0, 'Hộp nhựa trong suốt đựng yến', 'Hộp nhựa trong suốt đựng yến', 'Hộp nhựa trong suốt đựng yến', 7, 7, '2024-10-01 09:46:11', '2025-04-01 11:52:47'),
