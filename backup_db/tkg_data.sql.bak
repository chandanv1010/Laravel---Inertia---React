<li><span style="font-size:16px;"><strong>Vật liệu:</strong>&nbsp;Nhựa Pet, LDPE nguy&ecirc;n sinh,&nbsp;Nắp nh&ocirc;m</span></li>\r\n	<li><span style="font-size:16px;"><strong>M&agrave;u sắc</strong>: trong suốt</span></li>\r\n	<li><span style="font-size:16px;"><strong>Trọng lượng</strong>: 50g</span></li>\r\n	<li><span style="font-size:16px;"><strong>Trọng lượng Hộp+hạt điều:</strong>&nbsp;500g</span></li>\r\n	<li><span style="font-size:16px;"><strong>K&iacute;ch thước:</strong>&nbsp;ĐK nắp 90 x cao 220mm</span></li>\r\n	<li><span style="font-size:16px;"><strong>Quy c&aacute;ch: 91</strong>&nbsp;chiếc / kiện</span></li>\r\n</ul>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hu-nhua-nap-nhom-xe-up-web/1200-1.jpg" style="width: 500px; height: 417px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hu-nhua-nap-nhom-xe-up-web/1200-2.jpg" style="width: 500px; height: 418px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hu-nhua-nap-nhom-xe-up-web/1200-3.jpg" style="width: 500px; height: 417px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hu-nhua-nap-nhom-xe-up-web/1200-4.jpg" style="width: 500px; height: 417px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hu-nhua-nap-nhom-xe-up-web/1200-5.jpg" style="width: 500px; height: 417px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>&nbsp;</p>', '', 0, 945, 1, -1, -1, -1, 0, 1, 0, 'Hũ nhựa nắp nhôm xé', 'Hũ nhựa nắp nhôm xé', 'Hũ nhựa nắp nhôm xé', 7, 0, '2022-07-14 16:02:42', '0000-00-00 00:00:00');
