INSERT INTO `products` (`id`, `star`, `check`, `url`, `title`, `slug`, `canonical`, `link_shopee`, `cataloguesid`, `catalogues`, `images`, `albums`, `code`, `prefix`, `quantity`, `price`, `price_2`, `saleoff`, `coin`, `description`, `content`, `video`, `order`, `viewed`, `publish`, `highlight`, `ishome`, `isaside`, `isfooter`, `outstock`, `trash`, `meta_title`, `meta_keyword`, `meta_description`, `userid_created`, `userid_updated`, `created`, `updated`) VALUES
(38, 0, 0, '', 'Tấm nhựa lót sàn chăn nuôi', 'tam-nhua-lot-san-chan-nuoi', '', NULL, 2, '["1","2"]', '/uploads/images/san-pham-nhua/nhua-cong-nghiep/lsl1.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/lsl2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/lsl3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/lsl4.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/san-heo-40x55-cam.jpg-2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/san-heo-40x55-trang-1.jpg-2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/san-heo-cam-vang-trang-2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/san-heo-cam-trang-vang.jpg-2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/san-heo-trong-kho.jpg.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/san-heo-xep-chong.jpg.jpg","title":"","description":""}]', 'LSL1', 0, 200, 0, 0, 0, 0, '<p>Tấm nhựa l&oacute;t s&agrave;n chăn nu&ocirc;i</p>\r\n', '<p>Tấm nhựa l&oacute;t s&agrave;n chăn nu&ocirc;i</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><b><span style="font-size:13.5pt"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:black">Tấm nhựa l&oacute;t s&agrave;n 40x55 cao cấp TKG,</span></span></span></b><i><span style="font-size:13.5pt"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:black">&nbsp;(hay c&ograve;n được gọi c&aacute;c t&ecirc;n kh&aacute;c như sau: tấm nhựa l&oacute;t s&agrave;n chuồng ch&oacute;, tấm nhựa l&oacute;t s&agrave;n chuồng heo, tấm l&oacute;t s&agrave;n bằng nhựa, tấm l&oacute;t s&agrave;n nhựa cho heo&hellip;</span></span></span></i></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:13.5pt"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:black">- K&iacute;ch thước: d&agrave;i 55 cm x rộng 40 cm x cao 3,2 cm;</span></span></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:13.5pt"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:black">- Nguy&ecirc;n liệu: 100% nhựa nguy&ecirc;n sinh K8009 nhập khẩu từ Trung Đ&ocirc;ng + chất chống tia cực t&iacute;m UV khi để ngo&agrave;i &aacute;nh nắng mặt trời kh&ocirc;ng bị bay m&agrave;u.</span></span></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:13.5pt"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:black">- M&agrave;u sắc: trắng, v&agrave;ng, cam, xanh dương..... theo y&ecirc;u cầu của b&agrave; con.</span></span></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:13.5pt"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:black">- R&atilde;nh tho&aacute;t ph&acirc;n: 0,6 cm - 0,8 cm - 1,2 cm;</span></span></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:13.5pt"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:black">- Thương hiệu: TKG plastics</span></span></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:13.5pt"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:black">- Bảo h&agrave;nh: chọn đời sản phẩm thời hạn bảo h&agrave;nh 1 đổi 1 trong thời hạn 10 năm; đối với những sản phẩm do lỗi của nh&agrave; sản xuất g&acirc;y ra như bay m&agrave;u, cong v&ecirc;nh, tr&agrave;y xước, g&atilde;y bẻ.</span></span></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif"><span style="font-size:13.5pt"><span style="font-family:&quot;Arial&quot;,&quot;sans-serif&quot;"><span style="color:black">- Đặc điểm để ph&acirc;n biệt tấm nhựa l&oacute;t s&agrave;n cao cấp TKG plastics: mặt phẳng nhẵn đẹp, m&agrave;u sắc tươi, kh&ocirc;ng bavia, g&oacute;c cạnh sắc n&eacute;t, khi nắp gh&eacute;p th&agrave;nh 1 khối v&ocirc; c&ugrave;ng chắc chắn, chịu trọng tải lớn, si&ecirc;u bền trong qu&aacute; tr&igrave;nh sử dụng độ bền l&ecirc;n đến tr&ecirc;n 10 năm.</span></span></span></span></span></span></span></p>\r\n\r\n<p style="margin-bottom:.0001pt; text-align:justify; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,sans-serif">&nbsp;</span></span></span></span></p>', '', 0, 2363, 1, -1, -1, -1, 0, 1, 1, 'Tấm nhựa lót sàn chăn nuôi', 'Tấm nhựa lót sàn chăn nuôi', 'Tấm nhựa lót sàn chăn nuôi', 7, 7, '2018-09-20 14:38:21', '2018-09-21 11:37:33'),
(39, 15, 0, '', 'Bàn ghế nhựa mầm non', 'ban-ghe-nhua-mam-non', '', NULL, 10, '["1","10"]', '/uploads/images/san-pham-nhua/nhua-gia-dung/gte3.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-gia-dung\\/baee55456f5fc665fa946ac0708810e3c8f482a13ec4f32ee7-pimgpsh-fullsize-distr.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-gia-dung\\/bg1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-gia-dung\\/bg2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-gia-dung\\/bg2706.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-gia-dung\\/bte1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-gia-dung\\/bte2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-gia-dung\\/gte4.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-gia-dung\\/gte2.jpg","title":"105K c\\u00f2n 65K","description":"GH\\u1ebe m\\u1ea7m non: 53*31*28cm "},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-gia-dung\\/5731ef637fc89e96c7d9.jpg","title":"330k GI\\u1ea2M C\\u00d2N 230K","description":"Gi\\u01b0\\u1eddng 60*120cm "}]', 'BGTE1', 0, 0, 0, 0, 0, 0, '<p>B&agrave;n ghế nhựa mầm non&nbsp;</p>\r\n', '<p>&nbsp;GI&Aacute; XUẤT XƯỞNG D&Agrave;NH CHO C&Aacute;C TRƯỜNG MẪU GI&Aacute;O, MẦM NON Đ&Acirc;Y!</p>\r\n\r\n<p>B&agrave;n ghế nhựa PP nguy&ecirc;n sinh(Poly Propy len)</p>\r\n\r\n<p>- Kh&ocirc;ng m&agrave;u, kh&ocirc;ng m&ugrave;i, kh&ocirc;ng vị, kh&ocirc;ng độc hai</p>\r\n\r\n<p>- Độ bền cơ học v&agrave; độ b&oacute;ng bề mặt cao.</p>\r\n\r\n<p>- Chịu được nhiệt độ &gt; 100 độ C.</p>\r\n\r\n<p>- Chống thấm hơi nước, dầu mỡ v&agrave; c&aacute;c kh&iacute; kh&aacute;c</p>\r\n\r\n<p>- Tuyệt đối an to&agrave;n cho c&aacute;c b&eacute; trường mầm non, mẫu gi&aacute;o, c&aacute;c trung t&acirc;m gi&aacute;o dục...</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>Li&ecirc;n hệ đặt h&agrave;ng, mua h&agrave;ng trực tiếp tại:</p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p>C&Ocirc;NG TY CỔ PHẦN SẢN XUẤT V&Agrave; THƯƠNG MẠI TKG VIỆT NAM</p>\r\n\r\n<p>Nh&agrave; m&aacute;y sản xuất: Cụm c&ocirc;ng nghiệp Li&ecirc;n Phương- Thường T&iacute;n- H&agrave; Nội</p>\r\n\r\n<p>Call/ zalo: ☎️0983 81 2311 ☎️090456 9683</p>\r\n\r\n<p>nhuatkg.com</p>\r\n\r\n<p>email:khuonmautkg@gmail.com</p>\r\n\r\n<p>:tkgplastic@gmail.com</p>', '', 0, 4194, 1, -1, -1, -1, 0, 0, 1, 'Bàn ghế nhựa mầm non ', 'Bàn ghế nhựa mầm non ', 'Bàn ghế nhựa mầm non ', 7, 7, '2018-09-21 16:49:50', '2022-03-30 11:26:19'),
