(48, 5, 0, '', 'Hộp nhựa elip DE-400 ( 400g)', 'hop-nhua-elip-de-400-400g', '', NULL, 15, '["1","15"]', '/uploads/images/san-pham-nhua/vo-hop/he13.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he-01-49130.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he-01-49130d.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he-01-49130c.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he14.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he15.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he16.jpg","title":"","description":""}]', 'DE-400', 0, 1, 0, 0, 0, 0, '<p>Hộp nhựa elip DE-400- cao 49- trọng lượng : <u><span style="color:#e74c3c;"><span style="font-size:20px;"><strong>130g</strong></span></span></u></p>\r\n', '<p><strong>Hộp nhựa&nbsp;Elip 300-400g dầy</strong></p>\r\n\r\n<ul>\r\n	<li>K&iacute;ch thước: cao 49 x Mặt nắp(175x110) mm</li>\r\n</ul>\r\n\r\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Mặt đ&aacute;y(170x107)mm</p>\r\n\r\n<ul>\r\n	<li>Vật liệu : Nhựa GPPS nguy&ecirc;n sinh</li>\r\n	<li>M&agrave;u: Trong suốt</li>\r\n	<li>Trọng lượng: <u><strong><span style="font-size:20px;">130g</span></strong></u></li>\r\n</ul>', '', 1, 1609, 1, -1, -1, -1, 0, 1, 1, 'hộp nhựa trong suốt', 'hộp nhựa trong suốt', 'Hộp nhựa elip DE-400- cao 49- trọng lượng : 130g', 7, 7, '2019-02-25 14:13:45', '2019-06-10 15:02:39'),
(49, 0, 0, '', 'Hộp nhựa elip DE-300 (300g)', 'hop-nhua-elip-de-300-300g', 'hop-nhua-elip-de-300-300g', NULL, 15, '["1","15"]', '/uploads/images/san-pham-nhua/vo-hop/he14.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he02-45-130.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he02-45-130d.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he-02-45130c.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he5.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/ov8.png","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/ov9.jpg","title":"","description":""}]', 'DE-300', 0, 1, 0, 0, 0, 0, '<p>Hộp nhựa elip DE-300- cao 45 nặng :&nbsp;<u><span style="color:#e74c3c;"><strong><span style="font-size:20px;">130g</span></strong></span></u></p>\r\n', '<p><strong>Hộp nhựa&nbsp;Elip 300g&nbsp;dầy</strong></p>\r\n\r\n<ul>\r\n	<li>K&iacute;ch thước: cao 45&nbsp;x Mặt nắp(175x110) mm</li>\r\n</ul>\r\n\r\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Mặt đ&aacute;y(169x105)mm</p>\r\n\r\n<ul>\r\n	<li>Vật liệu : Nhựa GPPS nguy&ecirc;n sinh</li>\r\n	<li>M&agrave;u: Trong suốt</li>\r\n	<li>Trọng lượng: <u><strong><span style="font-size:20px;">130g</span></strong></u></li>\r\n</ul>', '', 0, 1829, 1, -1, -1, -1, 0, 1, 0, 'hộp nhựa trong suốt', 'hộp nhựa trong suốt', 'Hộp nhựa elip DE-300- cao 45 nặng 130g', 7, 7, '2019-02-25 14:59:26', '2019-06-10 15:04:03'),
(50, 0, 0, '', 'Hộp nhựa elip ME-400-62 (400g)', 'hop-nhua-elip-me-400-62-400g', '', NULL, 15, '["1","15"]', '/uploads/images/san-pham-nhua/vo-hop/he-03-40-6-25c.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he-03-40-6-25.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he-03-40-6-25c.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he-03-40-6-25d.jpg","title":"","description":""}]', 'ME-400-62', 0, 100, 0, 0, 0, 0, '<p>Hộp nhựa elip ME-400-62- 400g- cao- 40mm,nặng - 62,5g</p>\r\n', '<p><strong>Hộp nhựa&nbsp;Elip 400g</strong></p>\r\n\r\n<ul>\r\n	<li>K&iacute;ch thước: cao 40&nbsp;x Mặt nắp(180x120) mm</li>\r\n</ul>\r\n\r\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Mặt đ&aacute;y(176x118)mm</p>\r\n\r\n<ul>\r\n	<li>Vật liệu : Nhựa GPPS nguy&ecirc;n sinh</li>\r\n	<li>M&agrave;u: Trong suốt</li>\r\n	<li>Trọng lượng: 62.5g</li>\r\n</ul>', '', 2, 345, 1, -1, -1, -1, 0, 1, 1, 'hộp nhựa trong suốt giá rẻ', 'hộp nhựa trong suốt giá rẻ', 'Hộp nhựa elip ME-400-62- 400g- cao- 40mm,nặng - 62,5g', 7, 7, '2019-02-25 15:09:05', '2020-04-13 11:42:30'),
(51, 0, 0, '', 'Hộp nhựa elip ME-400-72(400g)', 'hop-nhua-elip-me-400-72-400g', '', NULL, 15, '["1","15"]', '/uploads/images/san-pham-nhua/vo-hop/he-04-49-72-3c.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he-04-49-72-3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he-04-49-72-3c.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/he-04-49-72-3d.jpg","title":"","description":""}]', 'ME-400-72', 0, 1, 0, 0, 0, 0, '<p>Hộp nhựa elip ME-400-72 (400g)- cao 49mm, nặng - 72.3g</p>\r\n', '<p><strong>Hộp nhựa&nbsp;Elip 400g&nbsp;</strong></p>\r\n\r\n<ul>\r\n	<li>K&iacute;ch thước: cao 49&nbsp;x Mặt nắp(175x110) mm</li>\r\n</ul>\r\n\r\n<p>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Mặt đ&aacute;y(167x105)mm</p>\r\n\r\n<ul>\r\n	<li>Vật liệu : Nhựa GPPS nguy&ecirc;n sinh</li>\r\n	<li>M&agrave;u: Trong suốt</li>\r\n	<li>Trọng lượng: 72,3g</li>\r\n</ul>', '', 3, 298, 1, -1, -1, -1, 0, 1, 1, 'Hộp nhựa elip', 'Hộp nhựa elip', 'Hộp nhựa elip ME-400-72 (400g)- cao 49mm, nặng - 72.3g', 7, 7, '2019-02-25 15:17:11', '2019-03-02 16:10:32'),
(52, 5, 0, '', 'Hộp nhựa elip oval bầu dục 130g', 'hop-nhua-elip-oval-bau-duc-130g', 'hop-nhua-elip-oval-bau-duc-130g', '', 18, '["1","18"]', '/uploads/images/san-pham-nhua/hop-nhua-trong-suot/de40/ed40.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/de40\\/ed40a.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/de40\\/ed40-1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/de40\\/ed40-2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/de40\\/ed40-3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/de40\\/ed40-kt.jpg","title":"","description":""}]', 'ME-300', 0, 1000, 9800, 0, 8800, 0, '<p style="margin-right:0cm; margin-left:0cm"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><strong><span style="font-size:15.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">* Lưu &yacute;: Gi&aacute; tr&ecirc;n l&agrave; gi&aacute; b&aacute;n lẻ</span></span></span></strong></span></span></p>\r\n\r\n<p style="margin-right:0cm; margin-left:0cm"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><strong><i><span style="font-size:15.0pt"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:#c0392b">* Mua số lượng lớn Qu&yacute; Kh&aacute;ch vui l&ograve;ng li&ecirc;n hệ Hotline/zalo: 090 456 9683 *** 0983 81 2311</span></span></span></i></strong></span></span></p>\r\n', '<p><span style="color:#c0392b;"><strong><span style="font-size:20px;">Hộp nhựa elip (oval, bầu dục) 130g</span></strong></span></p>\r\n\r\n<p>Chức năng:Vỏ hộp đựng b&aacute;nh kẹo, hạt điều, &ocirc; mai, mứt...</p>\r\n\r\n<ul>\r\n	<li>K&iacute;ch thước: cao 40&nbsp;x Mặt nắp(174x110) mm</li>\r\n</ul>\r\n\r\n<p>&nbsp; &nbsp; &nbsp; &nb