(4, 0, 'tkg việt nam 1536743292', 'tkg-viet-nam-1536743292', '', 1, '["1"]', '', '""', '<p>&nbsp;c&ocirc;ng ty cổ phần sản xuất v&agrave; thương mại tkg việt nam</p>', '<p>&nbsp;c&ocirc;ng ty cổ phần sản xuất v&agrave; thương mại tkg việt nam</p>', 0, 2, 1, -1, 0, 0, 0, 1, '', '', ' công ty cổ phần sản xuất và thương mại tkg việt nam', 7, 7, '2018-09-12 16:07:14', '2018-09-12 16:09:33'),
