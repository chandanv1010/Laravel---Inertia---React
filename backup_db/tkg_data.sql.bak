(104, 0, 0, '', 'Bánh xe con lăn phi 50mm', 'banh-xe-con-lan-phi-50mm', 'banh-xe-con-lan-phi-50mm', '', 1, '["1","2","32"]', '/uploads/images/san-pham-nhua/nhua-cong-nghiep/banh-xe/ban-sao-cua-ban-sao-cua-bao-bi-hop-nhua-2-.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/50u7.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/u10.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/50u5.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/50u6.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/50u8.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/50u9.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/50-h6.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/50-h1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/50-h2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/50-h5.jpg","title":"","description":""}]', 'D5023d10', 0, 1000, 39500, 0, 0, 0, '<p><span style="font-size:18px;"><strong><span style="color:#c0392b;">B&aacute;nh xe con lăn phi 50mm- R&atilde;nh H, R&atilde;nh U</span></strong></span></p>\r\n\r\n<p><span style="font-size:18px;"><strong><span style="color:#c0392b;"><iframe allowfullscreen="" frameborder="0" height="360" src="//www.youtube.com/embed/oIxxnZLpKpk" width="640"></iframe></span></strong></span></p>\r\n', '<p><span style="font-size:18px;"><strong><span style="color:#c0392b;">B&aacute;nh xe con lăn phi 50mm- R&atilde;nh H, R&atilde;nh U</span></strong></span></p>\r\n\r\n<p style="margin:0cm 0cm 8pt"><span style="font-size:14px;"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="line-height:107%">B&aacute;nh xe gồm 1 v&ograve;ng bi lớn 6200-2rs được &eacute;p đ&uacute;c bao quanh l&agrave; nhựa PA6 nguy&ecirc;n sinh. T&iacute;nh chất nhựa PA6 chống m&agrave;i m&ograve;n, chịu lực v&agrave; tải trọng lớn gi&uacute;p b&aacute;nh xe c&oacute; độ bền 10 năm kh&ocirc;ng hỏng.</span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 8pt"><span style="font-size:14px;"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="line-height:107%">B&aacute;nh xe con lăn nhựa 50mm l&agrave; giải ph&aacute;p ho&agrave;n hảo cho c&aacute;c nh&agrave; sản xuất cửa l&ugrave;a, cửa cuốn, cửa k&eacute;o&hellip;</span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 8pt"><span style="font-size:14px;"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="line-height:107%">B&aacute;nh xe gi&uacute;p cho cho cửa trượt được đẩy nhẹ nh&agrave;ng, &ecirc;m &aacute;i. </span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 8pt"><span style="font-size:14px;"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="line-height:107%">Nhựa TKG mong muốn đem đến sản phẩm bền bỉ với thời gian, an to&agrave;n đến tận tay người sử dụng. Ch&uacute;ng t&ocirc;i đặt UY T&Iacute;N- CHẤT LƯỢNG&nbsp; l&agrave; phương ch&acirc;m h&agrave;ng đầu trong sản xuất kinh doanh. Cam kết đảm bảo độ bền sản phẩm l&ecirc;n đến 10 năm.</span></span></span></span></p>\r\n\r\n<p style="margin:0cm 0cm 8pt"><span style="font-size:14px;"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="line-height:107%">TH&Ocirc;NG TIN CHI TIẾT SẢN PHẨM</span></b></span></span></span></p>\r\n\r\n<ul>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="color:#c0392b;"><span style="font-size:14px;"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="line-height:107%">B&aacute;nh xe con lăn phi 50mm- R&atilde;nh U</span></b></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">CL-D5023d10U16 (6200)</span></span></b></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Đường k&iacute;nh ngo&agrave;i: 50 x dầy 23mm</span></span></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Đường k&iacute;nh lỗ: 10&amp;12mm</span></span></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Rộng r&atilde;nh: 16mm x s&acirc;u r&atilde;nh 5mm</span></span></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Vật liệu nhựa PA nguy&ecirc;n sinh + v&ograve;ng bi bạc đạn 6200</span></span></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">M&agrave;u sắc: m&agrave;u trắng</span></span></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="color:#c0392b;"><span style="font-size:14px;"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="line-height:107%">B&aacute;nh xe con lăn phi 50mm- R&atilde;nh H</span></b></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><b><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">CL-D5023d10H16 (6200)</span></span></b></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Đường k&iacute;nh ngo&agrave;i: 50 x dầy 23mm</span></span></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Đường k&iacute;nh lỗ: 10&amp;12mm</span></span></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline"><span style="line-height:107%"><span style="font-family:Calibri,sans-serif"><span style="font-family:&quot;Arial&quot;,sans-serif"><span style="color:black">Rộng r&atilde;nh: 16mm x s&acirc;u r&atilde;nh 5mm</span></span></span></span></span></span></li>\r\n	<li style="margin: 0cm 0cm 8pt;"><span style="font-size:14px;"><span style="vertical-align:baseline