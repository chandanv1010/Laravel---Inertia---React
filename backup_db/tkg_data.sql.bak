(21, 25, 0, '', 'Vỏ hộp bánh kẹo, hạt điều hình Elip', 'vo-hop-banh-keo-hat-dieu-hinh-elip', '', NULL, 15, '["1","15"]', '/uploads/images/san-pham-nhua/vo-hop/ov1.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/ov1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/ov2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/ov3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/ov4.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/ov5.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/ov6.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/ov8.png","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/ov9.jpg","title":"","description":""}]', 'HE1', 0, 1, 0, 0, 0, 0, '<p>Vỏ hộp b&aacute;nh kẹo, hạt điều , mứt, &ocirc; mai h&igrave;nh Elip</p>\r\n', '<ul>\r\n	<li style="margin: 0in 0in 10pt;"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-size: 14pt;"><span style="font-family: inherit, serif;"><span style="color:#1d2129"><font face="Times New Roman, serif">H</font>&igrave;nh Elip c&oacute; 6 loại cho Ace lựa chọn. Đ&oacute;ng được 300-500g</span></span></span></span></span></span></li>\r\n</ul>\r\n\r\n<p style="margin-bottom:.0001pt; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-size: 14pt;"><span style="font-family: inherit, serif;"><span style="color:#1d2129">h&agrave;ng t&ugrave;y loại b&aacute;nh kẹo, hạt điều, &ocirc; mai hay nho kh&ocirc;.</span></span></span></span></span></span></p>\r\n\r\n<ul>\r\n	<li style="margin: 0in 0in 10pt;"><span style="font-size:14.0pt"><span style="line-height:115%"><span style="font-family:&quot;inherit&quot;,&quot;serif&quot;"><span style="color:#1d2129"><strong>Vật liệu</strong>: nhựa GPPS nguy&ecirc;n sinh- M&agrave;u: trong suốt</span></span></span></span></li>\r\n</ul>\r\n\r\n<ul>\r\n	<li style="margin: 0in 0in 10pt;"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,serif"><span style="font-size:14.0pt"><span style="font-family:&quot;inherit&quot;,&quot;serif&quot;"><span style="color:#1d2129">K&iacute;ch thước sản phẩm cụ thể như sau:</span></span></span></span></span></span></span></li>\r\n</ul>\r\n\r\n<p style="margin: 0in 0in 10pt;"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,serif"><span style="font-size:14.0pt"><span style="font-family:&quot;inherit&quot;,&quot;serif&quot;"><span style="color:#1d2129"><strong>H&igrave;nh Elip 400g</strong></span></span></span></span></span></span></span></p>\r\n\r\n<ul>\r\n	<li style="margin: 0in 0in 10pt;"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,serif"><span style="font-size:14.0pt"><span style="font-family:&quot;inherit&quot;,&quot;serif&quot;"><span style="color:#1d2129">K&iacute;ch thước: cao <strong>49</strong> x Mặt nắp(175x110) mm</span></span></span></span></span></span></span></li>\r\n</ul>\r\n\r\n<p style="margin-bottom:.0001pt; margin:0in 0in 10pt"><span style="font-size:11pt"><span style="background:white"><span style="line-height:normal"><span style="font-family:Calibri,serif"><span style="font-size:14.0pt"><span style="font-family:&quot;inherit&quot;,&quot;serif&quot;"><span style="color:#1d2129">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Mặt đ&aacute;y(167x105)mm</span></span></span></span></span></span></span></p>\r\n\r\n<ul>\r\n	<li style="margin: 0in 0in 10pt;"><span style="fon