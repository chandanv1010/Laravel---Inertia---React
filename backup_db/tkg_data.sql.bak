(64, 0, 0, '', 'Hộp đựng dây đai inox', 'hop-dung-day-dai-inox', 'hop-dung-day-dai-inox', NULL, 2, '["1","2"]', '/uploads/images/san-pham-nhua/nhua-cong-nghiep/ud-hop-dai-inox-1.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/kt1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/kt2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/kt3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/528b23006a369768ce27.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/249f651d2c2bd175883a.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/1321ebbca28a5fd4069b.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/96029694dfa222fc7bb3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/ac8fee1ba72d5a73033c.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/ud-hop-dai-inox-1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/ud-hop-dai-inox-2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/a4923ffb77cd8a93d3dc.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/f520fc44b472492c1063.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/b23d29bb608d9dd3c49c.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/14300c414477b929e066.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/27f2b6b6fe8003de5a91.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/180d9959d16f2c31757e.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/f44e9732df04225a7b15.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/hop-dai-inox-inox.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/hop-dai-inox-inox2.jpg","title":"","description":""}]', 'DIN01', 0, 500, 0, 0, 0, 0, '<p><iframe allowfullscreen="" frameborder="0" height="360" src="//www.youtube.com/embed/Te7qzi11E_k?autoplay=1" width="640"></iframe><span style="font-size:18px;"><strong>&nbsp;Hộp nhựa đựng d&acirc;y đai inox</strong></span></p>\r\n', '<p>&nbsp;T&ecirc;n sản phẩm: Hộp nhựa đựng d&acirc;y đai inox<br />\r\n* Chức năng sử dụng: Đựng d&acirc;y đai inox&nbsp;<br />\r\n* M&agrave;u sắc: Đen, Trắng, Đỏ, Xanh vv...( M&agrave;u sắc sản xuất theo y&ecirc;u cầu ...)<br />\r\n* Chất liệu: Nhựa ABS<br />\r\n* Gi&aacute;: <strong><em>Li&ecirc;n hệ ngay hotline/ zalo:&nbsp;&nbsp;090 456 9683 --- 0983 81 2311.</em></strong></p>\r\n\r\n<p><strong><em>Hộp mẫu</em></strong></p>\r\n\r\n<p><strong><em><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/ud-hop-dai-inox-2.jpg" style="width: 600px; height: 600px;" /></em></strong></p>\r\n\r\n<p><strong><em><span style="font-size:18px;">K&iacute;ch Thước hộp đai&nbsp; inox- DIN01</span></em></strong></p>\r\n\r\n<p><strong><em><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/kt1.jpg" style="width: 600px; height: 600px;" /></em></strong></p>\r\n\r\n<p><strong><em><span style="font-size:18px;">K&iacute;ch Thước hộp đai&nbsp; inox- DIN01- Chi tiết 3</span></em></strong></p>\r\n\r\n<p><strong><em><span style="font-size:18px;"><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/kt3.jpg" style="width: 600px; height: 600px;" /></span></em></strong></p>\r\n\r\n<p><strong><em><span style="font-size:18px;">Chi tiết 1- chi tiết 2</span></em></strong></p>\r\n\r\n<p><strong><em><span style="font-size:18px;"><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/kt2.jpg" style="width: 600px; height: 600px;" /></span></em></strong></p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/ac8fee1ba72d5a73033c.jpg" style="width: 600px; height: 600px;" /></p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/nhua-cong-nghiep/96029694dfa222fc7bb3.jpg" style="width: 600px; height: 600px;" /></p>\r\n\r\n<p>&nbsp;</p>', '', 0, 1840, 1, -1, -1, -1, 0, 1, 0, 'Hộp nhựa đựng dây đai inox', '', '', 7, 7, '2020-03-24 17:06:43', '2020-06-19 12:08:12'),
(65, 0, 0, '', 'Thanh lót kính nhựa PP', 'thanh-lot-kinh-nhua-pp', 'thanh-lot-kinh-nhua-pp', NULL, 2, '["1","2"]', '/uploads/images/san-pham-nhua/nhua-cong-nghiep/lk1.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/lk2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/lk3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/lk4.jpg","title":"","description":""}]', 'TL01', 0, 10000, 0, 0, 0, 0, '<p><iframe allowfullscreen="" frameborder="0" height="360" src="//www.youtube.com/embed/fC6MwwQtYlY" width="640"></iframe></p>\r\n', '<p>&nbsp;T&ecirc;n sản phẩm: Thanh l&oacute;t k&iacute;nh&nbsp;<br />\r\n* Chức năng sử dụng: D&ugrave;ng để l&oacute;t k&iacute;nh khi kẹp con lăn cửa trượt<br />\r\n* M&agrave;u sắc: Đen, Trắng, Đỏ, Xanh vv...( M&agrave;u sắc sản xuất theo y&ecirc;u cầu ...)<br />\r\n* Chất liệu: Nhựa PP</p>\r\n\r\n<p>* K&iacute;ch thước: 55x170mm<br />\r\n* Gi&aacute;:&nbsp;<strong><em>Li&ecirc;n hệ ngay hotline/ zalo:&nbsp;&nbsp;090 456 9683 --- 0983 81 2311.</em></strong></p>', '', 0, 1284, 1, -1, -1, -1, 0, 1, 0, 'gia công ép nhựa giá rẻ', 'gia công ép nhựa giá rẻ', '', 7, 7, '2020-04-02 13:23:21', '2020-04-02 13:55:43'),
(66, 0, 0, '', 'Hộp nhựa tròn 160g', 'hop-nhua-tron-160g', '', NULL, 15, '["1","15"]', '/uploads/images/san-pham-nhua/vo-hop/td5-9-.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/tron-day-500g-td5.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-12.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-16.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-4.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-5-.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-6-.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-7.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-8-.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-9-.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-13.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-14.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-15.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/vo-hop\\/td5-16.jpg","title":"","description":""}]', 'TD5', 0, 1000, 0, 0, 0, 0, '<p><span style="font-size:20px;"><strong>Hộp nhựa tr&ograve;n trong suốt 160g</strong></span></p>\r\n', '<p><span style="font-size:18px;"><strong>T&ecirc;n sản phẩm: Hộp nhựa tr&ograve;n 160g&nbsp;</strong></span></p>\r\n\r\n<p>* Chức năng sử dụng: Đựng b&aacute;nh kẹo, hạt điều, mứt, &ocirc;mai, thực phẩm kh&ocirc; kh&aacute;c...</p>\r\n\r\n<p>* M&agrave;u sắc: Trong suốt</p>\r\n\r\n<p>* Chất liệu: Nhựa GPPS nguy&ecirc;n sinh</p>\r\n\r\n<p>* K&iacute;ch thước: Phi 145mmx cao 56mm</p>\r\n\r\n<p>* Trọng lượng : <strong><span style="font-size:14px;">160g&nbsp;</span></strong></p>\r\n\r\n<p>* Tổng Hộp + Hạt = <span style="font-size:14px;"><strong>500g</strong></span></p>\r\n\r\n<p><br />\r\n* Gi&aacute;:&nbsp;<strong><em>Li&ecirc;n hệ ngay hotline/ zalo:&nbsp;&nbsp;090 456 9683 --- 0983 81 2311.</em></strong></p>', '', 11, 0, 1, -1, -1, -1, 0, 1, 1, 'hộp nhựa tròn 160g', 'hộp nhựa tròn trong suốt ', '', 7, 0, '2020-04-13 11:27:18', '0000-00-00 00:00:00'),
(67, 6, 0, '', 'Hộp nhựa tròn 160g đáy bằng', 'hop-nhua-tron-160g-day-bang', 'hop-nhua-tron-160g-day-bang', '', 18, '["1","18","20"]', '/uploads/images/san-pham-nhua/hop-nhua-trong-suot/td5/td5ns.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td5\\/s1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td5\\/td5-13.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td5\\/td5-160-1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td5\\/td5-9.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td5\\/td5-8.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td5\\/z4368857861864-a816590836fccf3141c7ee0a605c3439.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td5\\/td5-kt.jpg","title":"","description":""}]', 'TD5', 0, 10000, 10500, 0, 10500, 0, '<ul>\r\n	<li>\r\n	<p style="margin-right:0cm; margin-left:0cm"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><strong><span style="font-size:15.0pt"><span style="color:black">* Lưu &yacute;: Gi&aacute; tr&ecirc;n l&agrave; gi&aacute; b&aacute;n lẻ</span></span></strong></span></span></p>\r\n\r\n	<p style="margin-right:0cm; margin-left:0cm"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><strong><i><span style="font-size:15.0pt"><span style="color:#c0392b">* Mua số lượng lớn Qu&yacute; Kh&aacute;ch vui l&ograve;ng li&ecirc;n hệ Hotline/zalo: 090 456 9683 *** 0983 81 2311</span></span></i></strong></span></span></p>\r\n	</li>\r\n</ul>\r\n', '<p><span style="color:#c0392b;"><span style="font-size:18px;"><strong>Hộp nhựa tr&ograve;n 160g đ&aacute;y bằng</strong></span></span></p>\r\n\r\n<p>* Chức năng