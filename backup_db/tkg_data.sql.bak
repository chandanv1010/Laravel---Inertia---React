(1, 0, 'GIỚI THIỆU', 'gioi-thieu', '', 1, '["1"]', '', '""', '<p>&nbsp;c&ocirc;ng ty cổ phần sản xuất v&agrave; thương mại tkg việt nam</p>', '<p>c&ocirc;ng ty&nbsp;c&ocirc;ng ty cổ phần sản xuất v&agrave; thương mại tkg việt nam&nbsp;</p>\r\n\r\n<p>chuy&ecirc;n kinh doanh sản xuất c&aacute;c sản phẩm nhựa c&ocirc;ng nghiệp, nhựa gia dụng chất lượng cao</p>\r\n\r\n<p>nhựa nguy&ecirc;n sinh cao cấp</p>', 0, 9, 1, 1, 0, 1, 1, 1, 'tkg', 'tkg chế tạo khuôn mẫu chính xác', '', 7, 7, '2018-08-30 15:30:01', '2018-09-12 15:51:33'),
(2, 0, 'tkg việt nam', 'tkg-viet-nam', '', 1, '["1"]', '', '""', '<p>&nbsp;c&ocirc;ng ty cổ phần sản xuất v&agrave; thương mại tkg việt nam</p>', '<p>&nbsp;c&ocirc;ng ty cổ phần sản xuất v&agrave; thương mại tkg việt nam</p>', 0, 1, 1, 1, 0, 1, 1, 1, '', '', '', 7, 7, '2018-09-12 16:03:32', '2018-09-12 16:04:34'),
