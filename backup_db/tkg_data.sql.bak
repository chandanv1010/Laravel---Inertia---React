--
-- Table structure for table `promotionals`
--

CREATE TABLE IF NOT EXISTS `promotionals` (
  `id` int(11) NOT NULL,
  `title` varchar(225) COLLATE utf8_unicode_ci DEFAULT NULL,
  `coupon` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `coupon_condition` int(11) DEFAULT NULL,
  `promotion_outOfDate` tinyint(1) NOT NULL,
  `promotion_type` tinyint(1) NOT NULL,
  `promotion_discountType` varchar(25) COLLATE utf8_unicode_ci DEFAULT NULL,
  `promotion_discountValue` float NOT NULL,
  `promotion_discountItem` text COLLATE utf8_unicode_ci NOT NULL,
  `promotion_optionOffer` varchar(50) COLLATE utf8_unicode_ci DEFAULT NULL,
  `promotion_startDate` datetime NOT NULL,
  `promotion_endDate` datetime NOT NULL,
  `catalogues` text COLLATE utf8_unicode_ci,
  `publish` tinyint(1) NOT NULL,
  `trash` tinyint(1) NOT NULL,
  `userid_created` int(11) NOT NULL,
  `created` datetime NOT NULL,
  `userid_updated` int(11) NOT NULL,
  `updated` datetime NOT NULL
) ENGINE=MyISAM DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

