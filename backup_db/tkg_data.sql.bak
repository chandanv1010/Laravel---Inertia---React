(137, 0, 0, '', 'Bộ bánh xe rãnh V D60 1742267330', 'bo-banh-xe-ranh-v-d60-1742267330', '', '', 1, '["1","2","33"]', '/uploads/images/san-pham-nhua/nhua-cong-nghiep/banh-xe/khung-dang-shopee-cv2.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/kt3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/img-5663.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/img-5661.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/img-5644.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/img-5642-1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/img-5641-1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/img-5639.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/img-5636.jpg","title":"","description":""}]', '60V', 0, 100, 0, 0, 0, 0, '<p><strong>Bộ B&aacute;nh Xe R&atilde;nh V &ndash; phi 60mm</strong></p>\r\n', '<p><strong>Bộ B&aacute;nh Xe R&atilde;nh V &ndash; phi 60mm</strong></p>\r\n\r\n<p data-end="71" data-start="0">&nbsp;</p>', '', 7, 706, 1, 1, 1, 1, 0, 1, 0, 'Bộ bánh xe rãnh V D60', 'Bộ bánh xe rãnh V D60', 'Bộ bánh xe rãnh V D60', 7, 7, '2025-03-18 08:45:03', '2025-04-17 06:09:32');
