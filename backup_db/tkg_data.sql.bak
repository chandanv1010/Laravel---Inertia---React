(144, 0, 0, '', 'Bộ bánh xe rãnh U phi 50mm', 'bo-banh-xe-ranh-u-phi-50mm', 'bo-banh-xe-ranh-u-phi-50mm', '', 1, '["1","2","33"]', '/uploads/images/san-pham-nhua/nhua-cong-nghiep/banh-xe/cd50u.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/cd50u1.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/img-6671.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/img-6678.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/d50u-2.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/d50u-3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/d50u-4.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/d50u-5.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/d50u-6.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/d50u-7.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/d50u-8.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/nhua-cong-nghiep\\/banh-xe\\/d50u-9.jpg","title":"","description":""}]', 'B50U', 0, 1000, 0, 0, 0, 0, '<p>Bộ b&aacute;nh xe r&atilde;nh U phi 50mm</p>\r\n', '<p>Bộ b&aacute;nh xe r&atilde;nh U phi 50mm</p>', '', 1, 257, 1, -1, -1, -1, 0, 1, 0, 'Bộ bánh xe rãnh U phi 50mm', 'Bộ bánh xe rãnh U phi 50mm', 'Bộ bánh xe rãnh U phi 50mm', 7, 7, '2025-03-19 09:35:48', '2025-04-17 06:05:05'),
(145, 0, 0, '', 'Bánh xe dẫn hướng cửa lùa phi 37mm', 'banh-xe-dan-huong-cua-lua-phi-37mm', 'banh-xe-dan-huong-cua-lua-phi-37mm', '', 1, '["1","2","34"]', '/uploads/images/san-pham-nhua/banh-xe/khung-dang-shopee-d37.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/banh-xe\\/kich-thuoc-d37.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/banh-xe\\/z4424787923998-024ba404e109e741473721ccab40c91e.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/banh-xe\\/z4424787935334-b96111c65ecd13d058cd9765dbb97882.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/banh-xe\\/z4424787937532-11fe6050b7fe3c83e6d2095b5de51bd3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/banh-xe\\/z5550641768101-759a149ebc3ad193a6e66ed39ff6b720.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/banh-xe\\/z5550641786477-980746b574612d2ce9dfbee49d8f672a.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/banh-xe\\/z5550641791791-ebb00ce9be8bed7c0b2c71441c2855cf.jpg","title":"","description":""}]', 'D3712d10', 0, 1000, 0, 0, 0, 0, '<p>B&aacute;nh xe dẫn hướng cửa l&ugrave;a phi 37mm</p>\r\n', '<p>B&aacute;nh xe dẫn hướng cửa l&ugrave;a phi 37mm</p>\r\n\r\n<p><strong>B&aacute;nh Xe Dẫn Hướng Cửa L&ugrave;a Phi 37mm &ndash; Giải Ph&aacute;p Hỗ Trợ Di Chuyển Mượt M&agrave;</strong></p>\r\n\r\n<p>Bạn đang t&igrave;m kiếm một sản phẩm gi&uacute;p cửa l&ugrave;a vận h&agrave;nh ổn định, trơn tru v&agrave; đ&uacute;ng hướng? B&aacute;nh xe dẫn hướng cửa l&ugrave;a phi 37mm ch&iacute;nh l&agrave; phụ kiện kh&ocirc;ng thể thiếu trong c&aacute;c hệ thống cửa trượt, mang đến khả năng vận h&agrave;nh ch&iacute;nh x&aacute;c v&agrave; bền bỉ.</p>\r\n\r\n<h2><strong>Đặc Điểm Nổi Bật Của B&aacute;nh Xe Dẫn Hướng Phi 37mm</strong></h2>\r\n\r\n<h3><strong>1. Thiết Kế Nhỏ Gọn &ndash; Hiệu Quả Cao</strong></h3>\r\n\r\n<p>Với k&iacute;ch thước phi 37mm, b&aacute;nh xe c&oacute; thiết kế nhỏ gọn nhưng cực kỳ hiệu quả trong việc định hướng chuyển động cho cửa l&ugrave;a, gi&uacute;p cửa lu&ocirc;n đi đ&uacute;ng ray, kh&ocirc;ng bị lệch hay va chạm v&agrave;o khung.</p>\r\n\r\n<h3><strong>2. Chất Liệu Bền Bỉ &ndash; Chịu Tải Tốt</strong></h3>\r\n\r\n<p>Sản phẩm được l&agrave;m từ nhựa PA nguy&ecirc;n sinh chất lượng cao, c&oacute; khả năng chống m&agrave;i m&ograve;n tốt, kh&ocirc;ng bị nứt vỡ hay biến dạng trong qu&aacute; tr&igrave;nh sử dụng. Ph&ugrave; hợp với cả m&ocirc;i trường trong nh&agrave; lẫn ngo&agrave;i trời.</p>\r\n\r\n<h3><strong>3. V&ograve;ng Bi Th&eacute;p Ch&iacute;nh H&atilde;ng &ndash; Vận H&agrave;nh &Ecirc;m &Aacute;i</strong></h3>\r\n\r\n<p>Trang bị v&ograve;ng bi th&eacute;p ch&iacute;nh h&atilde;ng gi&uacute;p b&aacute;nh xe quay mượt m&agrave;, giảm ma s&aacute;t v&agrave; tiếng ồn tối đa. Nhờ đ&oacute;, cửa l&ugrave;a vận h&agrave;nh nhẹ nh&agrave;ng, tăng tuổi thọ cho cả b&aacute;nh xe v&agrave; hệ thống ray trượt.</p>\r\n\r\n<h3><strong>4. Lắp Đặt Dễ D&agrave;ng &ndash; Kh&ocirc;ng Cần Khoan, Cắt, H&agrave;n</strong></h3>\r\n\r\n<p>Kh&ocirc;ng giống như c&aacute;c sản phẩm tự chế, b&aacute;nh xe dẫn hướng phi 37mm được thiết kế để lắp đặt nhanh ch&oacute;ng v&agrave; tiện lợi. Qu&yacute; kh&aacute;ch chỉ cần bắt v&iacute;t cố định l&agrave; ho&agrave;n tất, kh&ocirc;ng tốn c&ocirc;ng sức chỉnh sửa hay gia c&ocirc;ng th&ecirc;m.</p>\r\n\r\n<h2><strong>Ứng Dụng Của B&aacute;nh Xe Dẫn Hướng 37mm</strong></h2>\r\n\r\n<ul>\r\n	<li>\r\n	<p>Hỗ trợ dẫn hướng cho cửa l&ugrave;a lớn, cửa nh&ocirc;m k&iacute;nh, cửa gỗ.</p>\r\n	</li>\r\n	<li>\r\n	<p>D&ugrave;ng cho c&aacute;c hệ cửa l&ugrave;a nh&agrave; kho, cửa tủ, cửa nh&agrave; xưởng.</p>\r\n	</li>\r\n	<li>\r\n	<p>Kết hợp c&ugrave;ng b&aacute;nh xe tải ch&iacute;nh để tăng độ ổn định khi vận h&agrave;nh.</p>\r\n	</li>\r\n</ul>\r\n\r\n<h2><strong>Tại Sao N&ecirc;n Chọn B&aacute;nh Xe Dẫn Hướng Phi 37mm?</strong></h2>\r\n\r\n<ul>\r\n	<li>\r\n	<p><strong>Thiết kế chuy&ecirc;n dụng cho dẫn hướng</strong> &ndash; Đảm bảo cửa lu&ocirc;n vận h&agrave;nh đ&uacute;ng hướng.</p>\r\n	</li>\r\n	<li>\r\n	<p><strong>Chất lượng cao cấp</strong> &ndash; Nhựa PA nguy&ecirc;n sinh, v&ograve;ng bi th&eacute;p bền bỉ.</p>\r\n	</li>\r\n	<li>\r\n	<p><strong>Dễ lắp đặt</strong> &ndash; Kh&ocirc;ng cần kỹ thuật phức tạp.</p>\r\n	</li>\r\n	<li>\r\n	<p><strong>Gi&aacute; th&agrave;nh hợp l&yacute;</strong> &ndash; Ph&ugrave; hợp với nhiều nhu cầu v&agrave; c&ocirc;ng tr&igrave;nh kh&aacute;c nhau.</p>\r\n	</li>\r\n</ul>\r\n\r\n<p>H&atilde;y lựa chọn ngay b&aacute;nh xe dẫn hướng cửa l&ugrave;a phi 37mm để đảm bảo cửa l&ugrave;a vận h&agrave;nh trơn tru, ch&iacute;nh x&aacute;c v&agrave; bền l&acirc;u!</p>', '', 0, 287, 1, 1, 1, 1, 0, 1, 0, 'Bánh xe dẫn hướng cửa lùa phi 37mm', 'Bánh xe dẫn hướng cửa lùa phi 37mm', 'Bánh xe dẫn hướng cửa lùa phi 37mm', 7, 0, '2025-04-17 06:44:32', '0000-00-00 00:00:00'),
