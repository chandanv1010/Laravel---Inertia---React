--
-- Table structure for table `projects`
--

CREATE TABLE IF NOT EXISTS `projects` (
  `id` int(11) NOT NULL,
  `title` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `slug` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `canonical` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `cataloguesid` int(11) NOT NULL,
  `code` varchar(50) COLLATE utf8_unicode_ci NOT NULL,
  `filterid` int(11) NOT NULL,
  `cityid` int(11) NOT NULL,
  `districtid` int(11) NOT NULL,
  `wardid` int(11) NOT NULL,
  `projectid` int(11) NOT NULL,
  `address` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `catalogues` text COLLATE utf8_unicode_ci NOT NULL,
  `images` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `albums` text COLLATE utf8_unicode_ci NOT NULL,
  `area` float NOT NULL,
  `floor` int(11) NOT NULL,
  `room` int(11) NOT NULL,
  `width` float NOT NULL,
  `price` int(20) NOT NULL,
  `measure` tinyint(1) NOT NULL,
  `type` tinyint(1) NOT NULL,
  `fullname_c` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `phone_c` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `email_c` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `address_c` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `description` text COLLATE utf8_unicode_ci NOT NULL,
  `content` longtext COLLATE utf8_unicode_ci NOT NULL,
  `map` text COLLATE utf8_unicode_ci NOT NULL,
  `order` int(11) NOT NULL,
  `viewed` tinyint(1) NOT NULL,
  `publish` tinyint(1) NOT NULL,
  `highlight` tinyint(1) NOT NULL,
  `ishome` tinyint(1) NOT NULL,
  `isaside` tinyint(1) NOT NULL,
  `isfooter` tinyint(1) NOT NULL,
  `trash` tinyint(1) NOT NULL,
  `meta_title` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `meta_keyword` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `meta_description` tinytext COLLATE utf8_unicode_ci NOT NULL,
  `userid_created` int(11) NOT NULL,
  `userid_updated` int(11) NOT NULL,
  `outofdate` datetime NOT NULL,
  `created` datetime NOT NULL,
  `updated` datetime NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

-- --------------------------------------------------------

--
-- Table structure for table `projects_catalogues`
--

CREATE TABLE IF NOT EXISTS `projects_catalogues` (
  `id` int(11) NOT NULL,
  `title` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `slug` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `canonical` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `parentid` int(11) NOT NULL,
  `lft` int(11) NOT NULL,
  `rgt` int(11) NOT NULL,
  `level` tinyint(1) NOT NULL,
  `order` tinyint(4) NOT NULL,
  `images` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `description` text COLLATE utf8_unicode_ci NOT NULL,
  `attributes` text COLLATE utf8_unicode_ci NOT NULL,
  `viewed` int(11) NOT NULL,
  `publish` tinyint(1) NOT NULL,
  `ishome` tinyint(1) NOT NULL,
  `highlight` tinyint(1) NOT NULL,
  `isaside` tinyint(1) NOT NULL,
  `isfooter` tinyint(1) NOT NULL,
  `trash` tinyint(1) NOT NULL,
  `meta_title` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `meta_keyword` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `meta_description` varchar(255) COLLATE utf8_unicode_ci NOT NULL,
  `userid_created` int(11) NOT NULL,
  `userid_updated` int(11) NOT NULL,
  `created` datetime NOT NULL,
  `updated` datetime NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_unicode_ci;

