(116, 6, 0, '', 'Hộp đựng hạt điều 160g đáy lõm', 'hop-dung-hat-dieu-160g-day-lom', 'hop-dung-hat-dieu-160g-day-lom', '', 18, '["1","18","20"]', '/uploads/images/san-pham-nhua/hop-nhua-trong-suot/td9/td9ns.jpg', '[{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td9\\/td9-160g.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td9\\/td9-3.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td9\\/td9-4.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td9\\/z509454541501117ef4120bca8fead6d81c84950254127-17096976600.jpg","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td9\\/hop-tron-xep-hoa2-hop-17104718216.png","title":"","description":""},{"images":"\\/uploads\\/images\\/san-pham-nhua\\/hop-nhua-trong-suot\\/td9\\/td9-kt.jpg","title":"","description":""}]', 'SP00000116', 0, 10000, 12500, 0, 10500, 0, '<ul>\r\n	<li>\r\n	<p style="margin-right:0cm; margin-left:0cm"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:12pt"><strong><span style="font-size:15.0pt"><span style="color:black">* Lưu &yacute;: Gi&aacute; tr&ecirc;n l&agrave; gi&aacute; b&aacute;n lẻ</span></span></strong></span></span></p>\r\n\r\n	<p style="margin-right:0cm; margin-left:0cm"><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:12pt"><strong><i><span style="font-size:15.0pt"><span style="color:#c0392b">* Mua số lượng lớn Qu&yacute; Kh&aacute;ch vui l&ograve;ng li&ecirc;n hệ Hotline/zalo: 090 456 9683 *** 0983 81 2311</span></span></i></strong></span></span></p>\r\n	</li>\r\n</ul>\r\n', '<p><span style="color:#c0392b;"><span style="font-size:20px;"><strong>Hộp nhựa tr&ograve;n 160g đ&aacute;y l&otilde;m</strong></span></span></p>\r\n\r\n<p>* Chức năng sử dụng: Đựng b&aacute;nh kẹo, hạt điều, mứt, &ocirc;mai, thực phẩm kh&ocirc; kh&aacute;c...</p>\r\n\r\n<p>* M&agrave;u sắc: Trong suốt</p>\r\n\r\n<p>* Chất liệu: Nhựa GPPS nguy&ecirc;n sinh</p>\r\n\r\n<p>* K&iacute;ch thước: Phi 145mmx cao 56mm</p>\r\n\r\n<p>* Trọng lượng : <strong><span style="font-size:14px;">160g&nbsp;</span></strong></p>\r\n\r\n<p>* Tổng Hộp + Hạt = <span style="font-size:14px;"><strong>500g</strong></span></p>\r\n\r\n<p><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:12pt"><strong><i><span style="font-size:15.0pt"><span style="color:#c0392b">* Mua số lượng lớn Qu&yacute; Kh&aacute;ch vui l&ograve;ng li&ecirc;n hệ Hotline/zalo: 090 456 9683 *** 0983 81 2311</span></span></i></strong></span></span></p>\r\n\r\n<p><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/td9/td9ns.jpg" style="width: 800px; height: 800px;" /></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:12pt"><strong><i><span style="font-size:15.0pt"><span style="color:#c0392b"><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/td9/td9-160g.jpg" style="width: 800px; height: 800px;" /></span></span></i></strong></span></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:12pt"><strong><i><span style="font-size:15.0pt"><span style="color:#c0392b"><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/td9/td9-3.jpg" style="width: 800px; height: 800px;" /></span></span></i></strong></span></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:12pt"><strong><i><span style="font-size:15.0pt"><span style="color:#c0392b"><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/td9/td9-4.jpg" style="width: 800px; height: 800px;" /></span></span></i></strong></span></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:12pt"><strong><i><span style="font-size:15.0pt"><span style="color:#c0392b"><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/td9/z509454541501117ef4120bca8fead6d81c84950254127-17096976600.jpg" style="width: 800px; height: 1067px;" /></span></span></i></strong></span></span></p>\r\n\r\n<p>&nbsp;</p>\r\n\r\n<p><span style="font-family:Arial,Helvetica,sans-serif;"><span style="font-size:12pt"><strong><i><span style="font-size:15.0pt"><span style="color:#c0392b"><img alt="" src="/uploads/images/san-pham-nhua/hop-nhua-trong-suot/td9/td9-kt.jpg" style="width: 800px; height: 800px;" /></span></span></i></strong></span></span></p>', '/uploads/media/5628794066023.mp4', 25, 4867, 1, 1, 1, 1, 0, 1, 0, 'Hộp đựng hạt điều 160g đáy lõm', 'Hộp đựng hạt điều 160g đáy lõm', 'Hộp đựng hạt điều 160g đáy lõm', 7, 7, '2020-04-13 11:27:18', '2025-04-01 05:24:44'),
